# Chép thành .env rồi sửa:  cp .env.example .env
# Để trống một biến = dùng giá trị mặc định trong code (ghi ở cuối mỗi dòng).
# Biến đặt trong shell (vd `PORT=3002 npm run dev`) được ưu tiên hơn .env.
# Docker không đọc file này: biến cho container nằm trong docker-compose.yml.

# ── Server ────────────────────────────────────────────────
# Cổng server Node. Khi `npm run dev`, Vite proxy /api, /socket.io về cổng này.  (mặc định 3001)
PORT=3001
# Địa chỉ listen.  (mặc định 0.0.0.0)
HOST=0.0.0.0
# Múi giờ tính "hôm nay", chuỗi ngày, tuần.  (mặc định Asia/Ho_Chi_Minh)
APP_TZ=Asia/Ho_Chi_Minh

# ── Dữ liệu ───────────────────────────────────────────────
# Thư mục chứa bank/, media/, app.db. Đường dẫn tương đối tính từ gốc repo.  (mặc định ./data)
DATA_DIR=./data
# File SQLite.  (mặc định $DATA_DIR/app.db)
DB_PATH=
# Thư mục vault Markdown TOEIC cho `npm run import`. Bắt buộc trên máy mới (hoặc truyền --path).
TOEIC_VAULT=/đường/dẫn/tới/TOEIC

# ── HTTPS ─────────────────────────────────────────────────
# Cần HTTPS để trình duyệt cho dùng micro khi mở bằng IP LAN.
# Dev: HTTPS=1 → Vite tự ký cert, mở https://<IP-máy>:5173.  (mặc định tắt)
HTTPS=
# Production: có cả hai thì server chạy HTTPS. Tạo bằng ./scripts/make-cert.sh.  (mặc định trống = HTTP)
TLS_CERT=
TLS_KEY=

# ── Voice ─────────────────────────────────────────────────
# JSON danh sách ICE server cho WebRTC. Thêm TURN nếu voice không thông qua NAT chặt (4G, mạng công ty).
# (mặc định [{"urls":"stun:stun.l.google.com:19302"}])
# Ví dụ có TURN: ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]'
ICE_SERVERS=

# ── Kiểm thử ──────────────────────────────────────────────
# Nhân thời gian làm bài. 0.01 = test tự nộp nhanh. Để 1 khi dùng thật.  (mặc định 1)
EXAM_TIME_SCALE=1
# Server mà `npm run smoke` / `npm run bots` gọi tới.  (mặc định http://localhost:$PORT)
BASE=
